# Copy this file to ".env" and fill in SMTP_PASS. Never commit ".env".

PORT=8787

# Where visitor messages are delivered
CONTACT_TO=ghazanfaralikhan62@gmail.com

# SMTP login used to send the email (Gmail example).
# SMTP_PASS must be a Gmail "App password", NOT your normal Gmail password:
#   Google Account -> Security -> turn on 2-Step Verification -> App passwords -> create one for "Mail".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ghazanfaralikhan62@gmail.com
SMTP_PASS=

# Optional
# MAIL_FROM=ghazanfaralikhan62@gmail.com   # defaults to SMTP_USER
# ALLOWED_ORIGIN=https://your-frontend-domain.com   # only if the website is hosted on a different domain than this API
# TRUST_PROXY=1                            # set to 1 when deployed behind a proxy/host (Render, Railway, Heroku, Nginx...)
# RATE_MAX=5                               # messages allowed per visitor IP ...
# RATE_WINDOW_MINUTES=15                   # ... per this many minutes
